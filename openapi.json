  "components": {
    "schemas": {
      "StatusResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "error": {
            "type": "string"
          }
        },
        "required": ["success"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string"
          }
        },
        "required": ["success", "error"]
      },
      "InstanceInfo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the instance"
          },
          "running": {
            "type": "boolean",
            "description": "Whether the server instance is currently running"
          },
          "config": {
            "$ref": "#/components/schemas/InstanceConfig"
          },
          "error": {
            "type": "string",
            "description": "Error message if any"
          }
        },
        "required": ["name", "running"]
      },
      "ListInstancesResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/StatusResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "instances": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/InstanceInfo"
                    }
                  },
                  "count": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        ]
