      "get": {
        "summary": "Get Game.ini configuration file content",
        "tags": ["Configuration"],
        "operationId": "getGameIni",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Instance name"
          }
